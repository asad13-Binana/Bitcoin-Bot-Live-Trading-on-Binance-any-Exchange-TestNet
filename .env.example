# Bitcoin Spot bot — copy to a private Oracle file, chmod 600, never commit it.
# Shipped safety default: deterministic simulation, entries OFF.
EXECUTION_MODE=simulation
BINANCE_SPOT_EXECUTION_PUBLIC_BASE=
PROTECTION_MODE=OCO_TRAILING
MAX_ENTRY_OPEN_SECONDS=300
LIVE_TRADING_ENABLED=false
AUTO_CONFIRM=false

# Host identity and persistent storage (Oracle installer sets these).
BOT_UID=1000
BOT_GID=1000
SHARED_HOST_PATH=/var/lib/bitcoin-bot/shared
RELEASE_TAG=local
# Written by the verified installer from the deployed release artifact.
SIDECAR_RELEASE_HASH=

# Exactly one BTC Spot pair. Owner can switch only while exchange + DB are flat.
ACTIVE_PAIR=BTC/USDT
# Optional comma-separated operator cap. Empty displays every currently
# eligible BTC-base Spot pair returned by Binance exchangeInfo.
BTC_QUOTE_ALLOWLIST=
BTC_PAIR_REGISTRY_TTL_SECONDS=300
TRADE_SIZE_QUOTE=100

# Dedicated Binance Spot-only API key. Disable withdrawals; IP-restrict it.
# Simulation does not require these. Testnet/live do.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Authenticated Spot request controls. recvWindow is intentionally capped at
# Binance's recommended maximum of 5000 ms; order POSTs are never auto-retried.
BINANCE_HTTP_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIME_SYNC_MAX_RTT_MS=2000

# Private service-bus keys: independently generated, 32+ random characters.
SIGNAL_HMAC_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
COMMAND_HMAC_KEY=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_VALUE
# Operator-held live-evidence verifier key; required only for live promotion.
# Ed25519 public key only (base64 DER). Keep the private certifier key offline.
LIVE_EVIDENCE_PUBLIC_KEY=

# Owner-only Telegram controller. Freqtrade's own Telegram remains disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
CALLBACK_TTL_SECONDS=120

# Internal loopback/container-only Freqtrade REST credentials.
FREQTRADE_API_USERNAME=freqtrade
FREQTRADE_API_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
FREQTRADE_API_JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
FREQTRADE_API_WS_TOKEN=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_VALUE

# Money-flow context (public endpoints only; never receives trading keys).
MONEYFLOW_REFRESH_SECONDS=15
MONEYFLOW_DEPTH_LIMIT=100
MONEYFLOW_TRADE_LIMIT=500
MONEYFLOW_DEPTH_BAND_BPS=10
FLOW_MIN_TAKER_BUY_RATIO=0.55
FLOW_MIN_SPOT_IMBALANCE=0.05
HTTP_TIMEOUT_SECONDS=15
PUBLIC_HTTP_MAX_ATTEMPTS=4
MAX_FLOW_AGE_SECONDS=45

# Advisory by default to preserve the uploaded strategy exactly.
REQUIRE_FLOW_CONTEXT=false
# If true, BTC/FDUSD currently fails closed because no matching USD-M perpetual exists.
REQUIRE_MATCHING_FUTURES=false

# Optional BTC/USD reference context. These providers are advisory only and
# never select pairs, size orders, validate filters, or affect trade decisions.
# Keep both OFF until dedicated free-plan keys are placed in this private file.
COINGECKO_CONTEXT_ENABLED=false
COINGECKO_API_KEY=
COINMARKETCAP_CONTEXT_ENABLED=false
COINMARKETCAP_API_KEY=

# Current official free quotas rechecked 2026-07-29, reduced by 4% and rounded
# down. Runtime bounds prevent raising these values above the safe caps.
# Five-minute cadence is at most 8,928 calls/provider in a 31-day month.
EXTERNAL_MARKET_REFRESH_SECONDS=300
EXTERNAL_MARKET_STALE_AFTER_SECONDS=900
EXTERNAL_MARKET_HTTP_TIMEOUT_SECONDS=10
COINGECKO_MAX_REQUESTS_PER_MINUTE=96
COINGECKO_MAX_MONTHLY_ATTEMPTS=9600
COINMARKETCAP_MAX_REQUESTS_PER_MINUTE=28
COINMARKETCAP_MAX_MONTHLY_ATTEMPTS=9600

# Spot protection and fee assumptions. Prove these on Testnet before live use.
TAKE_PROFIT_PCT=1.2
FIXED_STOP_PCT=2.0
TRAILING_DELTA_BIPS=40
LIMIT_FILL_BUFFER_BIPS=20
FEE_PCT_PER_SIDE=0.1
BREAK_EVEN_SLIPPAGE_PCT=0.05
SPOT_FILTER_MAX_AGE_SECONDS=300

# Live evidence parses an official Freqtrade result and applies all four gates.
LIVE_MIN_BACKTEST_TRADES=100
LIVE_MIN_PROFIT_FACTOR=1.15
LIVE_MIN_PROFIT_TOTAL=0
LIVE_MAX_DRAWDOWN_ACCOUNT=0.20
LIVE_MIN_BACKTEST_FEE=0.001
LIVE_EVIDENCE_RECHECK_SECONDS=30

# Cancel-and-replace automation is deliberately OFF until Testnet evidence exists.
AUTO_PROTECTION_ENABLED=false
AUTO_BREAK_EVEN_TRIGGER_PCT=0.5
AUTO_TIGHT_TRAIL_BIPS=20

# Freshness, cooldown and loss limits.
MAX_SIGNAL_AGE_SECONDS=180
MAX_CANDLE_AGE_SECONDS=180
PAIR_COOLDOWN_SECONDS=60
MAX_STOPOUTS_PER_PAIR_DAY=3
MAX_STOPOUTS_GLOBAL_DAY=10
COMMAND_MAX_AGE_SECONDS=120

# Bounded local state and logs.
COMMAND_RESULT_MAX_FILES=1000
COMMAND_RESULT_MAX_AGE_SECONDS=86400
SIGNAL_ARCHIVE_MAX_FILES=10000
SQLITE_BACKUP_INTERVAL_SECONDS=86400
SQLITE_BACKUP_RETAIN=14
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUPS=5
LOG_LEVEL=INFO
