{
  "schema_version": 1,
  "purpose": "Collision-free deployment of all four trading-bot repositories on one Oracle Always Free VM",
  "host_profile": {
    "minimum_ocpus": 2,
    "minimum_physical_memory_mib": 11264,
    "minimum_swap_mib": 3800,
    "minimum_free_disk_mib": 81920,
    "maximum_aggregate_container_cpus": 1.8,
    "maximum_aggregate_container_memory_mib": 5140
  },
  "instances": [
    {
      "slug": "binana-testnet",
      "family": "binana",
      "release_mode": "testnet",
      "compose_project": "binana-testnet",
      "service_image": "binana-testnet-services",
      "app_root": "/opt/binana-testnet",
      "private_root": "/etc/binana-testnet",
      "persistent_root": "/var/lib/binana-testnet",
      "monitor_port": 8090,
      "container_cpu_limit": 0.45,
      "container_memory_mib": 1370,
      "bot_user": "binanatn",
      "monitor_user": "binanatnmon",
      "systemd_prefix": "binana-testnet",
      "services": ["universe", "sharia-egress-proxy", "sharia-screener", "freqtrade", "execution-sidecar", "telegram-broker"],
      "required_timers": ["binana-testnet-disk-guard.timer", "binana-testnet-state-backup.timer", "binana-testnet-api-readiness.timer"],
      "deploy_wrapper": "/usr/local/sbin/binana-testnet-deploy"
    },
    {
      "slug": "bitcoin-testnet",
      "family": "bitcoin",
      "release_mode": "testnet",
      "compose_project": "bitcoin-testnet",
      "service_image": "bitcoin-testnet-services",
      "app_root": "/opt/bitcoin-testnet",
      "private_root": "/etc/bitcoin-testnet",
      "persistent_root": "/var/lib/bitcoin-testnet",
      "monitor_port": 8091,
      "container_cpu_limit": 0.45,
      "container_memory_mib": 1200,
      "bot_user": "bitcointn",
      "monitor_user": "bitcointnmon",
      "systemd_prefix": "bitcoin-testnet",
      "services": ["moneyflow", "freqtrade", "execution-sidecar", "telegram-broker"],
      "required_timers": ["bitcoin-testnet-resource-guard.timer", "bitcoin-testnet-state-backup.timer"],
      "deploy_wrapper": "/usr/local/sbin/bitcoin-testnet-deploy"
    },
    {
      "slug": "binana-live",
      "family": "binana",
      "release_mode": "live",
      "compose_project": "binana-live",
      "service_image": "binana-live-services",
      "app_root": "/opt/binana-live",
      "private_root": "/etc/binana-live",
      "persistent_root": "/var/lib/binana-live",
      "monitor_port": 8092,
      "container_cpu_limit": 0.45,
      "container_memory_mib": 1370,
      "bot_user": "binanalive",
      "monitor_user": "binanalivemon",
      "systemd_prefix": "binana-live",
      "services": ["universe", "sharia-egress-proxy", "sharia-screener", "freqtrade", "execution-sidecar", "telegram-broker"],
      "required_timers": ["binana-live-disk-guard.timer", "binana-live-state-backup.timer", "binana-live-api-readiness.timer"],
      "deploy_wrapper": "/usr/local/sbin/binana-live-deploy"
    },
    {
      "slug": "bitcoin-live",
      "family": "bitcoin",
      "release_mode": "live",
      "compose_project": "bitcoin-live",
      "service_image": "bitcoin-live-services",
      "app_root": "/opt/bitcoin-live",
      "private_root": "/etc/bitcoin-live",
      "persistent_root": "/var/lib/bitcoin-live",
      "monitor_port": 8093,
      "container_cpu_limit": 0.45,
      "container_memory_mib": 1200,
      "bot_user": "bitcoinlive",
      "monitor_user": "bitcoinlivemon",
      "systemd_prefix": "bitcoin-live",
      "services": ["moneyflow", "freqtrade", "execution-sidecar", "telegram-broker"],
      "required_timers": ["bitcoin-live-resource-guard.timer", "bitcoin-live-state-backup.timer"],
      "deploy_wrapper": "/usr/local/sbin/bitcoin-live-deploy"
    }
  ],
  "credential_isolation": {
    "telegram_bot_token": "distinct_for_every_instance",
    "service_hmac_keys": "distinct_for_every_instance_and_bus",
    "binance_api_key": "distinct_account_or_subaccount_and_key_for_every_non_simulation_instance",
    "withdrawals": "disabled_for_every_binance_key",
    "oracle_ip_restriction": "required_for_live_binance_keys",
    "market_data_keys": "separate_keys_or_operator_verified_aggregate_free_tier_budgets"
  }
}
