#!/usr/bin/env bash
# Root-owned, simulation-only entry point for the Oracle self-hosted runner.
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
IFS=$' \t\n'
unset BASH_ENV ENV CDPATH GLOBIGNORE \
  PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONWARNINGS \
  PYTHONBREAKPOINT PYTHONPYCACHEPREFIX
umask 077

RUNNER_USER=gha-runner
APP_ROOT=/opt/bitcoin-bot
RELEASES=$APP_ROOT/releases
CURRENT=$APP_ROOT/current
PERSIST_PARENT=/var/lib/bitcoin-bot
PERSIST=$PERSIST_PARENT/shared
INCOMING=$PERSIST_PARENT/incoming
ROOT_INCOMING=$PERSIST_PARENT/root-incoming
PRIVATE_ROOT=/etc/bitcoin-bot
ENV_FILE=$PRIVATE_ROOT/.env
APPROVED_DIGEST=$PRIVATE_ROOT/approved-artifact.sha256
CONSUMED_DIGEST=$PRIVATE_ROOT/last-consumed-artifact.sha256
INSTALLER=/usr/local/libexec/bitcoin-bot/install_artifact.sh
INCOMING_ARTIFACT=$INCOMING/bitcoin-bot-release.tar.gz
INCOMING_CHECKSUM=$INCOMING/bitcoin-bot-release.tar.gz.sha256
ACTION_LOCK=/var/lock/bitcoin-bot.actions-deploy.lock
MAX_ARCHIVE_CONTENT_MIB=1024

fail(){ echo "ERROR: $*" >&2; exit 1; }

require_canonical_dir(){
  local path=$1 uid=$2 gid=$3 mode=$4 resolved
  [[ -d "$path" && ! -L "$path" ]] || fail "required directory is missing or a symlink: $path"
  resolved=$(readlink -f "$path" 2>/dev/null || true)
  [[ "$resolved" == "$path" ]] || fail "required directory is not canonical: $path"
  [[ $(stat -c '%u' "$path") == "$uid" && $(stat -c '%g' "$path") == "$gid" ]] || \
    fail "required directory has unsafe ownership: $path"
  [[ $(stat -c '%a' "$path") == "$mode" ]] || \
    fail "required directory has unsafe mode: $path"
}

require_canonical_file(){
  local path=$1 uid=$2 gid=$3 mode=$4 resolved
  [[ -f "$path" && ! -L "$path" ]] || fail "required file is missing or a symlink: $path"
  resolved=$(readlink -f "$path" 2>/dev/null || true)
  [[ "$resolved" == "$path" ]] || fail "required file is not canonical: $path"
  [[ $(stat -c '%u' "$path") == "$uid" && $(stat -c '%g' "$path") == "$gid" ]] || \
    fail "required file has unsafe ownership: $path"
  [[ $(stat -c '%a' "$path") == "$mode" ]] || \
    fail "required file has unsafe mode: $path"
  [[ $(stat -c '%h' "$path") == 1 ]] || fail "required file has multiple hard links: $path"
}

approved_digest(){
  local lines digest extra
  require_canonical_file "$APPROVED_DIGEST" 0 0 600
  mapfile -t lines < <(awk 'NF {print}' "$APPROVED_DIGEST")
  [[ ${#lines[@]} == 1 ]] || \
    fail "$APPROVED_DIGEST must contain exactly one approved tarball SHA-256"
  read -r digest extra <<<"${lines[0]}"
  [[ "$digest" =~ ^[0-9a-fA-F]{64}$ && -z "${extra:-}" ]] || \
    fail "$APPROVED_DIGEST must contain only one full SHA-256"
  printf '%s' "${digest,,}"
}

simulation_env_preflight(){
  local runner_uid runner_gid
  runner_uid=$(id -u "$RUNNER_USER")
  runner_gid=$(id -g "$RUNNER_USER")
  [[ -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || fail "private env missing or unsafe: $ENV_FILE"
  [[ $(stat -c '%a' "$ENV_FILE") == 600 ]] || fail "$ENV_FILE must be mode 600"
  command -v runuser >/dev/null 2>&1 || fail "runuser is required"
  if runuser -u "$RUNNER_USER" -- test -r "$ENV_FILE"; then
    fail "$RUNNER_USER must not be able to read $ENV_FILE"
  fi
  for forbidden_group in docker sudo adm lxd disk root; do
    if id -nG "$RUNNER_USER" | tr ' ' '\n' | grep -Fxq "$forbidden_group"; then
      fail "$RUNNER_USER unexpectedly belongs to privileged group: $forbidden_group"
    fi
  done
  python3 - "$ENV_FILE" "$runner_uid" "$runner_gid" <<'PY'
import os
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
runner_uid = int(sys.argv[2])
runner_gid = int(sys.argv[3])
values = {}
for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
    if not match:
        raise SystemExit(f"private env line {number} is not a strict KEY=VALUE assignment")
    name, value = match.groups()
    if name in values:
        raise SystemExit(f"private env contains duplicate key: {name}")
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    values[name] = value

def require(name, minimum=1):
    value = values.get(name, "")
    if len(value) < minimum:
        raise SystemExit(f"{name} is missing or shorter than {minimum} characters")
    if any(word in value.upper() for word in (
        "REPLACE", "CHANGEME", "CHANGE_ME", "GENERATE", "EXAMPLE"
    )):
        raise SystemExit(f"{name} still contains a public placeholder")
    return value

if values.get("EXECUTION_MODE", "simulation") != "simulation":
    raise SystemExit("self-hosted wrapper permits EXECUTION_MODE=simulation only")
for name in ("LIVE_TRADING_ENABLED", "AUTO_CONFIRM", "AUTO_PROTECTION_ENABLED"):
    if values.get(name, "false").lower() != "false":
        raise SystemExit(f"{name} must be false for self-hosted simulation deployment")
if values.get("BINANCE_API_KEY", "") or values.get("BINANCE_API_SECRET", ""):
    raise SystemExit("self-hosted simulation deployment requires empty Binance credentials")
if values.get("SHARED_HOST_PATH") != "/var/lib/bitcoin-bot/shared":
    raise SystemExit("SHARED_HOST_PATH must equal /var/lib/bitcoin-bot/shared")

signal_key = require("SIGNAL_HMAC_KEY", 32)
command_key = require("COMMAND_HMAC_KEY", 32)
if signal_key == command_key:
    raise SystemExit("signal and command HMAC keys must be different")
freqtrade_values = {
    require("FREQTRADE_API_PASSWORD", 24),
    require("FREQTRADE_API_JWT_SECRET", 32),
    require("FREQTRADE_API_WS_TOKEN", 32),
}
if len(freqtrade_values) != 3:
    raise SystemExit("Freqtrade API password, JWT secret and WebSocket token must differ")
token = require("TELEGRAM_BOT_TOKEN", 24)
if not re.fullmatch(r"[0-9]+:[A-Za-z0-9_-]{20,}", token):
    raise SystemExit("TELEGRAM_BOT_TOKEN has invalid BotFather format")
if not re.fullmatch(r"-?[0-9]+", values.get("TELEGRAM_OWNER_CHAT_ID", "")):
    raise SystemExit("TELEGRAM_OWNER_CHAT_ID must be numeric")

try:
    bot_uid = int(values["BOT_UID"])
    bot_gid = int(values["BOT_GID"])
except (KeyError, ValueError):
    raise SystemExit("BOT_UID and BOT_GID must be explicit numeric values")
stat = path.stat()
if stat.st_uid != bot_uid or stat.st_gid != bot_gid:
    raise SystemExit("private env ownership does not match BOT_UID/BOT_GID")
if bot_uid == runner_uid or bot_gid == runner_gid:
    raise SystemExit("runner identity must be separate from the bot deployment identity")
print("private simulation environment validated without exposing values")
PY
}

prepare_approved_artifact(){
  local runner_uid runner_gid expected actual checksum_lines checksum_digest checksum_name extra
  runner_uid=$(id -u "$RUNNER_USER")
  runner_gid=$(id -g "$RUNNER_USER")
  require_canonical_dir "$INCOMING" "$runner_uid" "$runner_gid" 700
  require_canonical_dir "$ROOT_INCOMING" 0 0 700
  require_canonical_file "$INCOMING_ARTIFACT" "$runner_uid" "$runner_gid" 600
  require_canonical_file "$INCOMING_CHECKSUM" "$runner_uid" "$runner_gid" 600
  require_canonical_file "$INSTALLER" 0 0 755

  expected=$(approved_digest)
  PREPARED_DIR=$(mktemp -d "$ROOT_INCOMING/deploy.XXXXXX")
  chmod 0700 "$PREPARED_DIR"
  PREPARED_ARTIFACT=$PREPARED_DIR/bitcoin-bot-release.tar.gz
  PREPARED_CHECKSUM=$PREPARED_DIR/bitcoin-bot-release.tar.gz.sha256
  install -m 0600 -o root -g root "$INCOMING_ARTIFACT" "$PREPARED_ARTIFACT"

  actual=$(sha256sum "$PREPARED_ARTIFACT" | awk '{print $1}')
  [[ "$actual" == "$expected" ]] || fail "artifact does not match the root-approved SHA-256"
  mapfile -t checksum_lines < <(awk 'NF {print}' "$INCOMING_CHECKSUM")
  [[ ${#checksum_lines[@]} == 1 ]] || fail "adjacent checksum must contain one non-empty line"
  read -r checksum_digest checksum_name extra <<<"${checksum_lines[0]}"
  [[ "$checksum_digest" =~ ^[0-9a-fA-F]{64}$ \
     && -n "${checksum_name:-}" && -z "${extra:-}" \
     && "$checksum_name" != */* && "$checksum_name" != *\\* ]] || \
    fail "adjacent checksum has an unsafe format"
  [[ "${checksum_digest,,}" == "$actual" ]] || fail "adjacent checksum does not match artifact"
  printf '%s  %s\n' "$actual" "$(basename "$PREPARED_ARTIFACT")" > "$PREPARED_CHECKSUM"
  chmod 0600 "$PREPARED_CHECKSUM"
  PREPARED_DIGEST=$actual
}

verify_approved_archive(){
  local extract_root=$PREPARED_DIR/extracted
  install -m 0700 -d "$extract_root"
  python3 - "$PREPARED_ARTIFACT" "$extract_root" "$MAX_ARCHIVE_CONTENT_MIB" <<'PY'
import os
from pathlib import Path, PurePosixPath
import shutil
import sys
import tarfile

archive_path = Path(sys.argv[1])
destination = Path(sys.argv[2]).resolve()
maximum = int(sys.argv[3]) * 1024 * 1024
roots = set()
seen = set()
expanded = 0
with tarfile.open(archive_path, "r:*") as archive:
    members = archive.getmembers()
    if not members:
        raise SystemExit("empty release archive")
    for member in members:
        name = member.name
        pure = PurePosixPath(name)
        if "\\" in name or "\x00" in name or pure.is_absolute() or ".." in pure.parts:
            raise SystemExit(f"unsafe archive member: {name!r}")
        normal = pure.as_posix().rstrip("/")
        if normal in seen:
            raise SystemExit(f"duplicate archive member: {name}")
        seen.add(normal)
        if member.issym() or member.islnk() or member.isdev() or member.isfifo():
            raise SystemExit(f"unsupported archive member type: {name}")
        if not (member.isfile() or member.isdir()):
            raise SystemExit(f"unsupported archive member: {name}")
        expanded += max(0, member.size)
        if expanded > maximum:
            raise SystemExit("archive expanded size exceeds configured limit")
        if pure.parts:
            roots.add(pure.parts[0])
    if roots != {"bitcoin-bot"}:
        raise SystemExit("archive must have exactly the bitcoin-bot root")

    for member in members:
        pure = PurePosixPath(member.name)
        target = destination.joinpath(*pure.parts)
        resolved_parent = target.parent.resolve()
        if destination != resolved_parent and destination not in resolved_parent.parents:
            raise SystemExit(f"archive target escapes destination: {member.name}")
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
            os.chmod(target, 0o700)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        source = archive.extractfile(member)
        if source is None:
            raise SystemExit(f"cannot read archive member: {member.name}")
        with source, target.open("xb") as output:
            shutil.copyfileobj(source, output, length=1024 * 1024)
        os.chmod(target, 0o600)
print("approved archive structure safely extracted")
PY
  VERIFIED_RELEASE_DIR=$extract_root/bitcoin-bot
  (
    cd "$VERIFIED_RELEASE_DIR"
    python3 scripts/verify_manifest.py
    python3 tests/secret_scan.py
  )
  case "$(<"$VERIFIED_RELEASE_DIR/RELEASE_MODE")" in
    live|testnet) ;;
    *) fail "approved archive has an invalid RELEASE_MODE" ;;
  esac
  python3 - "$VERIFIED_RELEASE_DIR" <<'PY'
from pathlib import Path
import hashlib
import json
import sys

root = Path(sys.argv[1])
relative = "freqtrade/user_data/strategies/IctSmcStrategy.py"
manifest = json.loads((root / "RELEASE_MANIFEST.json").read_text(encoding="utf-8"))
expected = manifest["files"][relative]["sha256"]
actual = hashlib.sha256((root / relative).read_bytes()).hexdigest()
if actual != expected:
    raise SystemExit("protected strategy full-file SHA-256 mismatch")
print("protected strategy full-file SHA-256 verified:", actual)
PY
}

consume_approval(){
  local still_approved temporary
  still_approved=$(approved_digest)
  [[ "$still_approved" == "$PREPARED_DIGEST" ]] || \
    fail "root approval changed between verification and deployment"
  temporary=$PRIVATE_ROOT/.last-consumed-artifact.sha256.tmp
  printf '%s  consumed %s\n' "$PREPARED_DIGEST" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  mv -fT "$temporary" "$CONSUMED_DIGEST"
  : > "$APPROVED_DIGEST"
  chown root:root "$APPROVED_DIGEST"
  chmod 0600 "$APPROVED_DIGEST"
}

verify_runtime(){
  local release base config release_hash config_hash release_tag
  simulation_env_preflight
  [[ -L "$CURRENT" ]] || fail "current release symlink is absent"
  release=$(readlink -f "$CURRENT" 2>/dev/null || true)
  [[ -n "$release" && -d "$release" && ! -L "$release" \
     && $(dirname "$release") == "$RELEASES" ]] || fail "current release path is unsafe"
  base=$(basename "$release")
  [[ "$base" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || fail "current release name is not canonical"
  python3 "$release/scripts/verify_manifest.py"
  release_hash=$(awk 'NF {print $1; exit}' "$release/RELEASE_SHA256.txt")
  [[ "$release_hash" =~ ^[0-9a-f]{64}$ ]] || fail "current release hash is malformed"
  config=$PERSIST_PARENT/config-snapshots/$base.env
  [[ -f "$config" && ! -L "$config" ]] || fail "current release config snapshot is absent"
  config_hash=$(sha256sum "$config" | awk '{print $1}')
  release_tag=bitcoin-${release_hash:0:16}
  env -i "PATH=$PATH" "HOME=/root" \
    "RELEASE_TAG=$release_tag" "ENVELOPE_RELEASE_HASH=$release_hash" \
    "SIDECAR_RELEASE_HASH=$release_hash" "DEPLOYED_RELEASE_HASH=$release_hash" \
    "DEPLOYED_CONFIG_SHA256=$config_hash" "COMPOSE_PROJECT_NAME=bitcoin-bot" \
    python3 "$release/deploy/verify_stack_identity.py" \
      --release-dir "$release" \
      --releases-dir "$RELEASES" \
      --release-hash "$release_hash" \
      --config "$config" \
      --config-root "$PERSIST_PARENT/config-snapshots" \
      --config-sha256 "$config_hash" \
      --project bitcoin-bot
  python3 - "$PERSIST" "$release" "$release_hash" <<'PY'
import json
from pathlib import Path
import sys
import time

root = Path(sys.argv[1])
release = sys.argv[2]
release_hash = sys.argv[3]

def load(relative):
    path = root / relative
    if not path.is_file() or path.is_symlink():
        raise SystemExit(f"runtime evidence is missing or unsafe: {relative}")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"runtime evidence is malformed: {relative}") from exc
    if not isinstance(value, dict):
        raise SystemExit(f"runtime evidence is not an object: {relative}")
    return value

def fresh(row, maximum, label):
    try:
        age = time.time() - float(row["ts"])
    except (KeyError, TypeError, ValueError) as exc:
        raise SystemExit(f"{label} timestamp is missing or malformed") from exc
    if not -5 <= age < maximum:
        raise SystemExit(f"{label} health is stale or from the future")

deployment = load("runtime/deployment_status.json")
validation = load("runtime/release_validation.json")
sidecar = load("runtime/sidecar/sidecar_health.json")
moneyflow = load("runtime/moneyflow/moneyflow_health.json")
telegram = load("runtime/telegram/telegram_health.json")
active_pair = load("pair/active_pair.json")

if not (
    deployment.get("ok") is True
    and deployment.get("status") == "DEPLOYED"
    and deployment.get("release_hash") == release_hash
    and deployment.get("release_path") == release
    and deployment.get("execution_mode") == "simulation"
):
    raise SystemExit("deployment status does not identify the active simulation release")
if not (
    validation.get("ok") is True
    and validation.get("outcome") == "DEPLOYED"
    and validation.get("release_hash") == release_hash
    and validation.get("release_path") == release
    and validation.get("execution_mode") == "simulation"
    and validation.get("container_health_gate") == "passed"
    and validation.get("monitoring_health_gate") == "passed"
):
    raise SystemExit("release validation does not prove both deployment health gates")

fresh(sidecar, 30, "sidecar")
fresh(moneyflow, 90, "moneyflow")
fresh(telegram, 180, "telegram")
if not (
    sidecar.get("ok") is True
    and sidecar.get("execution_mode") == "simulation"
    and sidecar.get("simulation") is True
    and sidecar.get("entries_enabled") is False
    and sidecar.get("unresolved_intents") == 0
):
    raise SystemExit("sidecar is not in the healthy entries-off simulation state")
if moneyflow.get("ok") is not True:
    raise SystemExit("moneyflow service is not healthy")
if telegram.get("ok") is not True:
    raise SystemExit("Telegram broker is not healthy")
pair = str(active_pair.get("pair", ""))
if not pair.startswith("BTC/") or sidecar.get("active_pair") != pair:
    raise SystemExit("active pair is not one consistent BTC-base Spot pair")
print(f"simulation runtime verified: release={release_hash} pair={pair} entries_enabled=false")
PY
}

[[ $EUID -eq 0 ]] || fail "this wrapper must run as root through its exact sudo rule"
[[ $# == 1 ]] || fail "usage: bitcoin-bot-deploy preflight|simulation|verify"
case "$1" in
  preflight|simulation|verify) ;;
  *) fail "only preflight, simulation, or verify is permitted" ;;
esac

require_canonical_file "$ACTION_LOCK" 0 0 600
exec 8>"$ACTION_LOCK"
flock -n 8 || fail "another self-hosted deployment action is running"

PREPARED_DIR=''
PREPARED_ARTIFACT=''
PREPARED_CHECKSUM=''
PREPARED_DIGEST=''
cleanup(){
  if [[ -n "$PREPARED_DIR" && -d "$PREPARED_DIR" && ! -L "$PREPARED_DIR" \
     && $(dirname "$PREPARED_DIR") == "$ROOT_INCOMING" \
     && $(basename "$PREPARED_DIR") == deploy.* ]]; then
    rm -rf --one-file-system -- "$PREPARED_DIR"
  fi
}
trap cleanup EXIT

case "$1" in
  preflight)
    simulation_env_preflight
    prepare_approved_artifact
    verify_approved_archive
    echo "approved simulation artifact and private environment preflight passed"
    ;;
  simulation)
    simulation_env_preflight
    prepare_approved_artifact
    verify_approved_archive
    consume_approval
    env -i "PATH=$PATH" "HOME=/root" "EXPECTED_EXECUTION_MODE=simulation" \
      "$INSTALLER" "$PREPARED_ARTIFACT" "$PREPARED_CHECKSUM"
    ;;
  verify)
    verify_runtime
    ;;
esac
