# MONITORING-ONLY environment. Never place Binance/trading credentials here.
# Simulation observes public production market data but sends no exchange orders.
# Installed at /etc/bitcoin-bot/simulation-monitor.env (root:botmon 0640).
MONITOR_ENABLED=true
MONITOR_BIND_HOST=127.0.0.1
MONITOR_PORT=8091
MONITOR_TOKEN=replace_on_oracle_only
MONITOR_ALLOWED_IPS=127.0.0.1/32,::1/128
MONITOR_RATE_LIMIT_PER_MINUTE=30
MONITOR_ENABLE_DOCS=false
MONITOR_AUDIT_LOG=/var/log/bitcoin-bot/monitor/simulation-audit.jsonl
MONITOR_MONEYFLOW_MAX_AGE_SECONDS=90

BOT_MODE=simulation
BOT_DIRECTORY=/opt/bitcoin-bot/current
MONITOR_SHARED_ROOT=/var/lib/bitcoin-bot/shared
EXECUTION_DATABASE_PATH=/var/lib/bitcoin-bot/shared/runtime/sidecar/execution_state.sqlite
EXECUTION_PNL_LEDGER_PATH=/var/lib/bitcoin-bot/shared/runtime/sidecar/pnl_ledger.jsonl
SIGNAL_DATABASE_PATH=/var/lib/bitcoin-bot/shared/freqtrade/tradesv3.signal-only.sqlite
FT_LOG_PATH=/var/lib/bitcoin-bot/shared/freqtrade/logs/freqtrade.log
ACTIVE_PAIR_STATUS_PATH=/var/lib/bitcoin-bot/shared/pair/active_pair.json
MONEYFLOW_STATUS_PATH=/var/lib/bitcoin-bot/shared/moneyflow/latest.json
MONEYFLOW_HEALTH_PATH=/var/lib/bitcoin-bot/shared/runtime/moneyflow/moneyflow_health.json
SIDECAR_HEALTH_PATH=/var/lib/bitcoin-bot/shared/runtime/sidecar/sidecar_health.json
TELEGRAM_HEALTH_PATH=/var/lib/bitcoin-bot/shared/runtime/telegram/telegram_health.json
DEPLOY_STATUS_PATH=/var/lib/bitcoin-bot/shared/runtime/deployment_status.json
VALIDATION_STATUS_PATH=/var/lib/bitcoin-bot/shared/runtime/release_validation.json
CONTAINER_STATUS_PATH=/var/lib/bitcoin-bot/shared/runtime/container_status.json
USER_STREAM_HEALTH_PATH=/var/lib/bitcoin-bot/shared/runtime/sidecar/user_stream_health.json
BINANCE_REST_BASE=https://api.binance.com

TELEGRAM_REPORTS_ENABLED=false
TELEGRAM_MONITOR_BOT_TOKEN=replace_on_oracle_only
TELEGRAM_MONITOR_CHAT_ID=replace_on_oracle_only
MONITOR_URL=http://127.0.0.1:8091
